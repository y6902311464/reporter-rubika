# ═══════════════════════════════════════════════════════════════
# راهنمای تنظیمات فایل .env — AmirWebCode Self Bot
# ═══════════════════════════════════════════════════════════════
#
#  این فایل الگویی برای .env هست. مقادیر زیر رو کپی کنید
#  و در فایل .env (کنار این فایل) جایگزین کنید.
#
#  ⚠️ فایل .env هرگز نباید وارد Git بشه!
# ═══════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────
# 🔑 اطلاعات تلگرام (الزامی)
# ─────────────────────────────────────────────
# از @BotFather بگیرید
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# از https://my.telegram.org بگیرید
TELEGRAM_API_ID=YOUR_API_ID_HERE
TELEGRAM_API_HASH=YOUR_API_HASH_HERE

# آیدی عددی خودتون (از @userinfobot)
OWNER_ID=YOUR_TELEGRAM_ID_HERE

# ─────────────────────────────────────────────
# 🏷️ نام و هویت ربات
# ─────────────────────────────────────────────
# نام نمایشی ربات (هر جا اسم ربات دیده میشه)
BOT_DISPLAY_NAME=AmirWebCode Self

# یوزرنیم مالک ربات (برای نمایش در پنل)
BRAND_OWNER_USERNAME=YOUR_USERNAME

# یوزرنیم سازنده/پشتیبان (Powered by)
BRAND_POWERED_BY_USERNAME=YOUR_USERNAME

# لینک گروه ربات (URL دعوت یا @username)
BRAND_GROUP_USERNAME=https://t.me/YOUR_GROUP_LINK

# ─────────────────────────────────────────────
# 📢 عضویت اجباری (Force-Join Channel)
# ─────────────────────────────────────────────
# کانالی که کاربران باید عضو بشن تا ربات کار کنه
FORCE_JOIN_ENABLED=1
FORCE_JOIN_CHAT_ID=@YOUR_CHANNEL_USERNAME
FORCE_JOIN_USERNAME=YOUR_CHANNEL_USERNAME
FORCE_JOIN_TITLE=YOUR_CHANNEL_NAME
FORCE_JOIN_URL=https://t.me/YOUR_CHANNEL_USERNAME

# ─────────────────────────────────────────────
# 💰 پرداخت و قیمت‌گذاری
# ─────────────────────────────────────────────
# قیمت هر سکه (تومان) — مثال: 1000 سکه × 100 = 100,000 تومان
COIN_PRICE_TOMAN=100

# شماره کارت بانکی برای پرداخت
PAYMENT_CARD_NUMBER=YOUR_CARD_NUMBER

# اسم صاحب کارت
PAYMENT_CARD_HOLDER=YOUR_NAME_ON_CARD

# یوزرنیم تلگرام برای ارسال رسید پرداخت
PAYMENT_CONTACT_USERNAME=YOUR_USERNAME

# ─────────────────────────────────────────────
# 🪙 سکه و اشتراک
# ─────────────────────────────────────────────
# هزینه فعال‌سازی سلف (سکه) — مثال: 1000 سکه = 100,000 تومان
ACTIVATION_COST_COINS=1000

# هزینه روزانه سلف (0 = رایگان بعد از فعال‌سازی)
DAILY_SELF_COST_COINS=0

# هدیه به کاربر جدید (سکه)
NEW_USER_GIFT_COINS=3

# پاداش معرفی (سکه)
REFERRAL_REWARD_COINS=7

# حداقل انتقال سکه
TRANSFER_MIN_COINS=1

# حداکثر انتقال سکه
TRANSFER_MAX_COINS=1000

# سقف انتقال روزانه
TRANSFER_DAILY_LIMIT_COINS=5000

# کارمزد بازی (درصد — 0 = بدون کارمزد)
BETTING_FEE_PERCENT=0

# ─────────────────────────────────────────────
# 🎧 پشتیبانی
# ─────────────────────────────────────────────
SUPPORT_URL=https://t.me/YOUR_SUPPORT_USERNAME

# ─────────────────────────────────────────────
# 👥 آیدی‌های ادمین
# ─────────────────────────────────────────────
# آیدی عددی ادمین‌های تأیید رسید (با کاما جدا کنید)
# مثال: 123456789,987654321
RECEIPT_ADMIN_IDS=

# آیدی‌های هدف سلف (برای ارسال پیام)
SELF_ADMIN_TARGET=@YOUR_ADMIN_USERNAME
SELF_GROUP_TARGET=@YOUR_GROUP_USERNAME
SELF_CHANNEL_TARGET=@YOUR_CHANNEL_USERNAME

# ─────────────────────────────────────────────
# ⚙️ سایر تنظیمات (معمولاً نیازی به تغییر نیست)
# ─────────────────────────────────────────────
BOT_DATA_DIR=data
BOT_SESSIONS_DIR=sessions
BOT_TIMEZONE=Asia/Tehran
MAX_IN_MEMORY_MEDIA_MB=50
HELPER_START_TIMEOUT=20
HELPER_WATCHDOG_INTERVAL=30
SELF_START_TIMEOUT=45
SELF_WATCHDOG_INTERVAL=30
SELF_RESTART_MAX_BACKOFF=300
SELF_RESTART_CONCURRENCY=3
BETTING_GAME_TTL_MINUTES=15
BETTING_CLEANUP_INTERVAL=60
BETTING_MAX_STAKE=1000000
BETTING_MAX_OPEN_GAMES_PER_USER=3
BETTING_RATE_WINDOW_SECONDS=60
BETTING_CREATE_RATE_LIMIT=3
BETTING_CANCEL_RATE_LIMIT=3
BETTING_JOIN_RATE_LIMIT=8
BETTING_CLEANUP_BATCH_SIZE=20
BETTING_HISTORY_RETENTION_DAYS=365
BETTING_TRANSACTION_RETENTION_DAYS=730
BETTING_CLOSURE_MAX_RETRIES=20
BETTING_RESULT_MAX_RETRIES=20
BETTING_ALLOWED_CHAT_IDS=
